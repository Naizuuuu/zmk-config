#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;

            hold-while-undecided;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "hold-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <20 0 1 2 3 4 10 11 12 13 14 25 24 23 22 21 32 33 34 35 36 37>;
            hold-while-undecided;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "hold-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <32 33 34 35 36 37 15 5 26 27 16 7 6 17 28 8 18 29 9 19 30 31>;
            hold-while-undecided;
        };

        hmcr: hmcr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMCR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 25 24 23 22 21 32 33 34 35 36 37 5>;
            hold-while-undecided;
        };
    };

    combos {
        compatible = "zmk,combos";

        refresh {
            bindings = <&kp F5>;
            key-positions = <3 4>;
        };

        xcape {
            bindings = <&kp ESCAPE>;
            key-positions = <4 5>;
        };

        insertion {
            bindings = <&kp F6>;
            key-positions = <5 6>;
        };

        FF4 {
            bindings = <&kp F4>;
            key-positions = <14 15>;
        };

        FF2 {
            bindings = <&kp F2>;
            key-positions = <25 26>;
        };
    };

    macros {
        mypw: mypw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(I) &kp O &kp A &kp N &kp N3 &kp N2 &kp N3 &kp N1 &kp N5 &kp RBKT>,
                <&macro_press>,
                <&kp ENTER>,
                <&macro_release>;

            label = "MYPW";
        };

        misispw: misispw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LS(J) &kp A &kp P &kp A &kp N &kp N &kp O &kp V &kp E &kp M &kp B &kp E &kp R &kp N2 &kp N0 &kp N2 &kp N6 &kp STAR>,
                <&macro_press>,
                <&kp ENTER>,
                <&macro_release>;

            label = "MISISPW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
                 &kp Q  &kp W  &kp E         &kp R         &kp T              &kp Y        &kp U         &kp I          &kp O    &kp P
                 &kp A  &kp S  &kp D         &hml LCTRL F  &kp G              &kp H        &hmr RCTRL J  &kp K          &kp L    &kp APOS
&hmcr LCTRL TAB  &kp Z  &kp X  &kp C         &kp V         &kp B              &kp N        &kp M         &kp COMMA      &kp DOT  &kp SLASH  &kp ENTER
                               &kp LEFT_ALT  &lt 3 SPACE   &lt 1 BACKSPACE    &lt 2 SPACE  &lt 2 SPACE   &kp RIGHT_GUI
            >;
        };

        Sym {
            label = "Sym";
            bindings = <
        &kp EXCLAMATION  &kp AT             &kp POUND              &kp SEMICOLON  &kp LBRC    &kp RIGHT_BRACE        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp ASTERISK
        &kp LEFT_SHIFT   &kp GRAVE          &trans                 &trans         &kp LBKT    &kp RIGHT_BRACKET      &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS
&trans  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp TILDE      &kp LPAR    &kp RIGHT_PARENTHESIS  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PLUS      &trans
                                            &trans                 &trans         &trans      &trans                 &kp SLASH        &kp NUMBER_0
            >;
        };

        Nav {
            label = "Nav";
            bindings = <
        &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT    &kp CARET      &kp AMPS        &kp STAR        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
        &trans    &trans  &trans    &trans      &trans         &kp PAGE_UP    &kp LEFT_ARROW  &kp UP          &kp RIGHT             &trans
&trans  &trans    &trans  &trans    &trans      &trans         &kp PAGE_DOWN  &kp HOME        &kp DOWN_ARROW  &kp END               &trans                 &trans
                          &trans    &trans      &trans         &trans         &trans          &trans
            >;
        };

        Tune {
            bindings = <
        &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &kp PRINTSCREEN    &kp F1        &kp F2  &kp F3  &kp F4  &kp F5
        &none       &none         &none         &trans        &kp SCROLLLOCK     &kp F6        &kp F7  &kp F8  &kp F9  &kp F10
&trans  &none       &none         &none         &none         &bt BT_SEL 2       &kp C_VOL_DN  &none   &none   &none   &none    &trans
                                  &trans        &trans        &trans             &trans        &trans  &trans
            >;

            label = "Tune";
        };

        Cyr {
            bindings = <
          &kp Q  &kp W  &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P
          &kp A  &kp S  &kp D   &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI
&kp RBKT  &kp Z  &kp X  &kp C   &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp APOS  &kp LBKT
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Cyrillics";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        raise_lower {
            if-layers = <2 1>;
            then-layer = <3>;
        };
    };
};
